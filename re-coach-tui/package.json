{
  "name": "recoach-tui",
  "version": "0.1.0",
  "description": "知返 Re: Coach - 个性化 ML/DL 学习讲解 Agent 的终端(TUI)版本",
  "type": "module",
  "bin": {
    "recoach": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
