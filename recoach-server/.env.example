# ---------- 基础 ----------
RECOACH_DB_PATH=./recoach.db
RECOACH_DEV_USER=dev_user
RECOACH_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# ---------- 访问控制 ----------
# 留空 = 开发模式：/api/v1 只接受本机回环客户端。
RECOACH_API_TOKEN=
# 开发模式下是否允许本机无凭证访问。
RECOACH_ALLOW_LOCAL_WITHOUT_TOKEN=true
# 开发模式下额外信任的 IP / CIDR；Docker Compose 默认使用 172.28.0.0/24。
RECOACH_TRUSTED_HOSTS=
# 进程实例标识。启动时的"遗留 streaming Turn 恢复"只作用于本实例创建的 Turn。
# 留空 = 用库内持久化的随机标识（DB 在挂载卷上，重启/重建容器后不变），单实例部署保持默认即可。
# 只有当**同一份 DB 上跑多个进程**（如 uvicorn --workers 4）时才需要给每个进程设不同值，
# 否则它们会互相回收对方正在流式输出的轮次。
RECOACH_INSTANCE_ID=
# 是否暴露 /docs 与 /openapi.json；留空时令牌模式关闭、开发模式开启。
# RECOACH_EXPOSE_DOCS=false

# 单用户锁定。留空（默认）= 保持单机单人模型：身份由 x-user-id 表达，
# 任何持令牌者都能指定任意身份。本机单人使用时没有实际风险。
# 一旦把服务暴露给更多人（同机多账户、内网共享），把它设成你的用户标识即可钉死身份；
# 请求里再带别的 x-user-id 会被拒绝（401），而不是被静默忽略。
# 只允许 [A-Za-z0-9._@:-] 且长度 1..128；填错会让进程直接启动失败（fail loud）。
RECOACH_LOCKED_USER=

# ---------- 主 Coach 模型 ----------
# template | openai_compatible | deepseek | anthropic
RECOACH_LLM_PROVIDER=template

# 通用 OpenAI Chat Completions 兼容服务
# 配了 API Key 时，Base URL 必须是 https://，否则 Authorization 头会明文上路。
# http:// 只允许回环与私有网段（容器指向宿主机的 Ollama / vLLM 等本地推理服务）；
# 指向公网地址的 http:// 会让进程**启动失败**——这类错误静默运行看不出来，
# 代价却是密钥泄露，所以选择响亮失败而不是警告。
RECOACH_LLM_BASE_URL=
RECOACH_LLM_API_KEY=
RECOACH_LLM_MODEL=

# DeepSeek 官方 API
# 也可使用系统环境变量 DEEPSEEK_API_KEY
RECOACH_DEEPSEEK_API_KEY=
RECOACH_DEEPSEEK_BASE_URL=https://api.deepseek.com
RECOACH_DEEPSEEK_MODEL=deepseek-v4-flash
RECOACH_DEEPSEEK_THINKING=enabled

# reasoning_effort 档位选择（重要！）
# 基于实测性能数据：
#
# low（推荐用于交互场景）:
#   - 首字延迟: 3.1s
#   - 端到端: 10.6s  
#   - thinking: ~3000字符 (~2000 tokens)
#   - 正文: 充足空间
#   - 适用: 日常学习对话、快速答疑
#
# medium（深度推理场景）:
#   - 首字延迟: 48s
#   - 端到端: 67s
#   - thinking: ~6000字符 (~4000 tokens)
#   - 正文: 可能被挤压
#   - 适用: 复杂数学推导、多步骤推理
#
# high（极复杂场景，慎用）:
#   - 首字延迟: >60s
#   - thinking: ~9000字符 (~6000 tokens)
#   - 适用: 研究级问题、极深推理链
#
RECOACH_DEEPSEEK_REASONING_EFFORT=low

# Anthropic 官方 API（也可使用 ANTHROPIC_API_KEY）
RECOACH_ANTHROPIC_API_KEY=
RECOACH_ANTHROPIC_MODEL=claude-opus-5

# LLM通用配置
# max_tokens 设置建议：
# - DeepSeek low档: 8000-10000（thinking 2k + 正文 6-8k）
# - DeepSeek medium档: 12000+（thinking 4k + 正文 8k+）
# - 其他provider: 6000-8000
RECOACH_LLM_MAX_TOKENS=10000
# 请求超时（秒）。语义是**两次数据之间的间隔**上限，不是整轮总时长：
# 流式回答只要持续吐字，跑多久都不会被这个值掐断（配成 90 时，一轮持续
# 输出三分钟是正常的）。TUI 用的是同一语义。
# 之所以要写明：按"总时长"理解会导致长回答被拦腰截断，而这类误配很难察觉。
RECOACH_LLM_TIMEOUT=90
RECOACH_LLM_MAX_CONTINUATIONS=2
# 首字前 provider 失败时：false=模板兜底，true=直接返回 MODEL_UNAVAILABLE。
RECOACH_LLM_FAIL_FAST=false

# ---------- 资源限制 ----------
# 计费型请求的每身份每分钟上限，0 = 关闭。
RECOACH_RATE_LIMIT_PER_MINUTE=30
# 同时进行中的流式 Turn 上限，0 = 不限制。
RECOACH_MAX_CONCURRENT_TURNS=16
# 请求体上限（字节），0 = 不限制。
RECOACH_MAX_BODY_BYTES=65536

# ---------- 记忆与预算 ----------
RECOACH_MEMORY_ON=true
RECOACH_MEMORY_MAX_SELECTED=3
RECOACH_MEMORY_HARD_LIMIT=4
RECOACH_MEMORY_CAPSULE_TOKENS=280

# 微型实验工具尚未实现（/meta 的 microExperiment 为 False），这一项**当前不生效**，
# 是为 P1 预留的接口形状。设置它不会改变任何行为。
RECOACH_TOOL_BUDGET=1
